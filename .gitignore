.env
.env.*
!.env.example
!.env.production
local.settings.json

# Empacotamento
*.zip

# shared vendorizado por scripts/build; a fonte unica e shared/shared/
backend/shared/
function/shared/

# OS / editor
.DS_Store
.idea/
.vscode/

# Metadata do Windows (download via WSL/Explorer)
*:Zone.Identifier

# limpeza temporaria
_to_delete/

# Estado do ambiente local (pids e logs do start-local.sh)
.local/
